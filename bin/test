#!/usr/bin/env sh
# Build and run the model, export and command line tests (no window, and
# bin/fake-scanimage in place of a scanner).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"
qmake6 "$ROOT/tests/tests.pro" >/dev/null
make -j"$(nproc 2>/dev/null || echo 1)" >/dev/null
QT_QPA_PLATFORM=offscreen ./omascan-tests "$@"
